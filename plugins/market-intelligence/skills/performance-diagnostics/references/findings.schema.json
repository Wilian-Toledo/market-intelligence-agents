{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Diagnostic Findings v0.3 (local-only)",
  "description": "Achados rastreáveis e exploratórios. Arquivos preenchidos com informações do projeto não pertencem ao repositório público.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "analysis_question",
    "catalog_path",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "mode": {
      "enum": [
        "exploratory",
        "executive_ready"
      ]
    },
    "analysis_question": {
      "type": "string",
      "minLength": 1
    },
    "catalog_path": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "headline",
          "finding_type",
          "confidence",
          "kpi_ids",
          "evidence_refs",
          "period",
          "segment",
          "limitations",
          "next_check",
          "restricted_conditions_verified",
          "restriction_evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "minLength": 1
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "finding_type": {
            "enum": [
              "observation",
              "hypothesis"
            ]
          },
          "confidence": {
            "enum": [
              "preliminary",
              "validated"
            ]
          },
          "kpi_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "segment": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next_check": {
            "type": "string",
            "minLength": 1
          },
          "restricted_conditions_verified": {
            "type": "boolean"
          },
          "restriction_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
